<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtStepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compteur de pas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:id="@+id/txtStepStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="En attente du capteur..."
        android:textSize="16sp"
        android:gravity="center"
        android:padding="8dp" />

    <TextView
        android:id="@+id/txtTotalSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pas depuis le dernier redémarrage : --"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:id="@+id/txtSessionSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pas depuis l'ouverture de cette page : --"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="12dp" />

</LinearLayout>