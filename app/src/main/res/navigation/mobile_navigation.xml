<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="ensa.ma.sensors.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_share"
        android:name="ensa.ma.sensors.ui.share.ShareFragment"
        android:label="@string/menu_share"
        tools:layout="@layout/fragment_share" />

    <fragment
        android:id="@+id/nav_list"
        android:name="ensa.ma.sensors.ui.sensors.ListSonsorsFragment"
        android:label="fragment_listsonsors_list"
        tools:layout="@layout/fragment_listsonsors_list" />

    <fragment
        android:id="@+id/nav_temp"
        android:name="ensa.ma.sensors.ui.thermometer.ThermoFragment"
        android:label="fragment_thermo"
        tools:layout="@layout/fragment_thermo" />
    <fragment
        android:id="@+id/nav_humd"
        android:name="ensa.ma.sensors.ui.humidity.HumidityFragment"
        android:label="fragment_humidity"
        tools:layout="@layout/fragment_humidity" />
    <fragment
        android:id="@+id/nav_proximity"
        android:name="ensa.ma.sensors.ui.proximity.ProximityFragment"
        android:label="fragment_proximity"
        tools:layout="@layout/fragment_proximity" />
    <fragment
        android:id="@+id/nav_magnetic"
        android:name="ensa.ma.sensors.ui.magnetic.MagneticFragment"
        android:label="fragment_magnetic"
        tools:layout="@layout/fragment_magnetic" />
    <fragment
        android:id="@+id/nav_compass"
        android:name="ensa.ma.sensors.fragments.CompassFragment"
        android:label="fragment_compass"
        tools:layout="@layout/fragment_compass" />
    <fragment
        android:id="@+id/rotation_sensor"
        android:name="ensa.ma.sensors.ui.rotation.RotationFragment"
        android:label="Rotation Sensor"
        tools:layout="@layout/fragment_rotation" />
    <fragment
        android:id="@+id/nav_accelerometer"
        android:name="ensa.ma.sensors.fragments.MotionSensorFragment"
        android:label="Accéléromètre"
        tools:layout="@layout/fragment_motion_sensor">

        <argument
            android:name="sensor_type"
            app:argType="integer"
            android:defaultValue="1" />

        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="Accéléromètre" />

        <argument
            android:name="unit"
            app:argType="string"
            android:defaultValue="m/s²" />
    </fragment>

    <!-- Gravité -->
    <fragment
        android:id="@+id/nav_gravity"
        android:name="ensa.ma.sensors.fragments.MotionSensorFragment"
        android:label="Gravité"
        tools:layout="@layout/fragment_motion_sensor">

        <argument
            android:name="sensor_type"
            app:argType="integer"
            android:defaultValue="9" />

        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="Gravité" />

        <argument
            android:name="unit"
            app:argType="string"
            android:defaultValue="m/s²" />
    </fragment>

    <!-- Gyroscope -->
    <fragment
        android:id="@+id/nav_gyroscope"
        android:name="ensa.ma.sensors.fragments.MotionSensorFragment"
        android:label="Gyroscope"
        tools:layout="@layout/fragment_motion_sensor">

        <argument
            android:name="sensor_type"
            app:argType="integer"
            android:defaultValue="4" />

        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="Gyroscope" />

        <argument
            android:name="unit"
            app:argType="string"
            android:defaultValue="rad/s" />
    </fragment>
    <fragment
        android:id="@+id/nav_step_counter"
        android:name="ensa.ma.sensors.fragments.StepCounterFragment"
        android:label="Compteur de pas"
        tools:layout="@layout/fragment_step_counter" />

    <fragment
        android:id="@+id/nav_activity_recognition"
        android:name="ensa.ma.sensors.fragments.ActivityRecognitionFragment"
        android:label="Reconnaissance d'activité"
        tools:layout="@layout/fragment_activity_recognition" />

</navigation>